{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atsuki-seo/Kosen-MCC/schema/errata.schema.json",
  "title": "原本の表記ゆれと誤記",
  "description": "data/mcc2023/errata.yaml。正本の原文は直さず、ここに記録する（設計 5.5）",
  "type": "object",
  "required": ["meta", "entries"],
  "additionalProperties": false,
  "properties": {
    "meta": {"$ref": "common.schema.json#/$defs/meta"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "summary", "occurrences"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^errata-[0-9]{3}$"},
          "kind": {"enum": ["表記ゆれ", "誤記の可能性", "番号の重複", "空欄", "記載の食い違い"]},
          "summary": {"type": "string"},
          "occurrences": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["page_pdf", "quote"],
              "additionalProperties": false,
              "properties": {
                "page_pdf": {"$ref": "common.schema.json#/$defs/page"},
                "quote": {"type": "string", "description": "原文のまま。ページの抽出テキストに含まれることを検査する"}
              }
            }
          },
          "related_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/anyId"}}
        }
      }
    }
  }
}
