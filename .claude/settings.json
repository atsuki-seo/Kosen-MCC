{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python tools/hooks/check_commit_email.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python tools/hooks/validate_data.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python tools/hooks/check_build.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(build/**)",
      "Edit(source/**)"
    ]
  }
}
